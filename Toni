<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1.0,maximum-scale=1.0,user-scalable=no">
<title>Prof. TONI — Plateforme v4</title>
<script src="https://www.gstatic.com/firebasejs/10.12.0/firebase-app-compat.js"></script>
<script src="https://www.gstatic.com/firebasejs/10.12.0/firebase-database-compat.js"></script>
<script src="https://www.gstatic.com/firebasejs/10.12.0/firebase-auth-compat.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.min.js"></script>
<style>
@import url('https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;600;700;800;900&family=JetBrains+Mono:wght@400;700&display=swap');
:root{
  --bg:#060a12;--sf:#0c1420;--sf2:#101c30;--sf3:#152238;
  --bd:#1a2c48;--bd2:#243d5c;
  --gr:#22d3a0;--gr2:#0fa876;--or:#f97316;--or2:#ea580c;
  --rd:#ef4444;--yw:#fbbf24;--bl:#3b82f6;--pu:#a855f7;
  --tx:#e2e8f0;--mu:#64748b;--mu2:#94a3b8;--go:#f59e0b;
  --nh:62px;--hh:52px;--th:48px;
}
*{margin:0;padding:0;box-sizing:border-box;-webkit-tap-highlight-color:transparent;}
html,body{min-height:100%;font-family:'Outfit',sans-serif;background:var(--bg);color:var(--tx);}
.screen{display:none;min-height:100vh;flex-direction:column;}
.screen.active{display:flex;}

/* LANDING */
#s-land{overflow-y:auto;}
.hero{text-align:center;padding:3rem 1.5rem 1.5rem;position:relative;overflow:hidden;}
.hero::before{content:'';position:absolute;top:-80px;left:50%;transform:translateX(-50%);width:500px;height:500px;background:radial-gradient(circle,var(--gr)09,transparent 70%);pointer-events:none;}
.hero-badge{display:inline-flex;align-items:center;gap:.4rem;background:var(--gr)15;border:1px solid var(--gr)33;border-radius:20px;padding:.3rem .85rem;font-family:'JetBrains Mono',monospace;font-size:.68rem;color:var(--gr);text-transform:uppercase;letter-spacing:1px;margin-bottom:1rem;}
.hero-h{font-size:clamp(1.8rem,7vw,2.8rem);font-weight:900;line-height:1.1;margin-bottom:.6rem;}
.hero-h .g{background:linear-gradient(135deg,var(--gr),var(--bl));-webkit-background-clip:text;-webkit-text-fill-color:transparent;}
.hero-p{font-size:.88rem;color:var(--mu2);line-height:1.6;max-width:340px;margin:0 auto 1.5rem;}
.hero-btns{display:flex;flex-direction:column;gap:.65rem;max-width:300px;margin:0 auto;}
.hbtn{padding:.85rem;border-radius:12px;font-weight:800;font-size:.92rem;cursor:pointer;border:none;font-family:'Outfit',sans-serif;transition:opacity .2s;}
.hbtn:active{opacity:.75;}
.hbtn-g{background:var(--gr);color:#000;}
.hbtn-o{background:var(--or)22;color:var(--or);border:1.5px solid var(--or)44;}
.hbtn-gh{background:transparent;color:var(--mu);font-size:.75rem;}
.plans-sec{padding:1rem 1rem 2rem;}
.plans-h{text-align:center;font-size:1.1rem;font-weight:800;margin-bottom:.25rem;}
.plans-p{text-align:center;font-size:.78rem;color:var(--mu2);margin-bottom:1rem;}
.ptog-row{display:flex;background:var(--sf);border:1px solid var(--bd);border-radius:12px;padding:3px;margin-bottom:1rem;}
.ptog{flex:1;padding:.48rem;text-align:center;border-radius:9px;font-size:.78rem;font-weight:700;color:var(--mu);cursor:pointer;transition:all .2s;}
.ptog.on{background:var(--gr);color:#000;}
.pgrid{display:flex;flex-direction:column;gap:.65rem;}
.pcard{background:var(--sf2);border:1.5px solid var(--bd);border-radius:14px;padding:1.1rem;position:relative;overflow:hidden;}
.pcard.pop{border-color:var(--gr)66;}
.pcard.pop::before{content:'⭐ POPULAIRE';position:absolute;top:0;right:0;background:var(--gr);color:#000;font-size:.56rem;font-weight:800;padding:.2rem .65rem;border-radius:0 12px 0 9px;letter-spacing:.5px;}
.pname{font-size:.75rem;font-weight:800;color:var(--mu2);text-transform:uppercase;letter-spacing:1px;margin-bottom:.25rem;}
.pprice{font-size:1.6rem;font-weight:900;line-height:1;}
.pprice span{font-size:.75rem;color:var(--mu2);font-weight:400;}
.pdur{font-size:.7rem;color:var(--mu);margin:.1rem 0 .65rem;}
.pfeats{list-style:none;display:flex;flex-direction:column;gap:.25rem;margin-bottom:.85rem;}
.pfeats li{font-size:.78rem;color:var(--mu2);display:flex;align-items:center;gap:.3rem;}
.ok{color:var(--gr);}.no{color:var(--rd);opacity:.55;}
.pbtn{width:100%;padding:.68rem;border-radius:9px;border:none;font-family:'Outfit',sans-serif;font-weight:800;font-size:.85rem;cursor:pointer;transition:opacity .2s;}
.pbtn:active{opacity:.7;}
.pbtn-fr{background:var(--sf3);color:var(--tx);border:1px solid var(--bd2);}
.pbtn-g{background:var(--gr);color:#000;}
.pbtn-o{background:linear-gradient(135deg,var(--or),var(--or2));color:#fff;}

/* AUTH */
#s-auth{align-items:center;justify-content:center;padding:1.5rem;overflow-y:auto;}
.acard{background:var(--sf2);border:1px solid var(--bd);border-radius:20px;padding:1.8rem 1.4rem;width:100%;max-width:380px;}
.alogo{text-align:center;margin-bottom:1.3rem;}
.alogo .lg{font-size:1.7rem;font-weight:900;background:linear-gradient(135deg,var(--gr),var(--or));-webkit-background-clip:text;-webkit-text-fill-color:transparent;}
.alogo .sb{font-size:.7rem;color:var(--mu);font-family:'JetBrains Mono',monospace;}
.atabs{display:flex;background:var(--sf);border:1px solid var(--bd);border-radius:10px;padding:3px;margin-bottom:1.3rem;}
.atab{flex:1;padding:.48rem;text-align:center;border-radius:8px;font-size:.78rem;font-weight:700;color:var(--mu);cursor:pointer;transition:all .2s;}
.atab.on{background:var(--gr);color:#000;}
.fld{margin-bottom:.85rem;}
.fld label{display:block;font-size:.73rem;font-weight:700;color:var(--mu2);margin-bottom:.28rem;}
.fld input,.fld select{width:100%;background:#ffffff08;border:1.5px solid var(--bd);border-radius:10px;padding:.68rem .85rem;color:var(--tx);font-family:'Outfit',sans-serif;font-size:.88rem;outline:none;transition:border-color .2s;}
.fld input:focus,.fld select:focus{border-color:var(--gr)77;}
.fld select option{background:var(--sf2);}
.asub{width:100%;padding:.8rem;background:var(--gr);color:#000;border:none;border-radius:12px;font-family:'Outfit',sans-serif;font-weight:800;font-size:.92rem;cursor:pointer;margin-top:.35rem;transition:opacity .2s;}
.asub:active{opacity:.8;}
.aback{text-align:center;margin-top:.85rem;font-size:.76rem;color:var(--mu2);}
.aback a{color:var(--gr);cursor:pointer;font-weight:700;}

/* COMMUN */
.hdr{height:var(--hh);background:var(--sf);border-bottom:1px solid var(--bd);display:flex;align-items:center;justify-content:space-between;padding:0 1rem;flex-shrink:0;position:sticky;top:0;z-index:50;}
.brand{font-size:1rem;font-weight:900;background:linear-gradient(90deg,var(--gr),var(--bl));-webkit-background-clip:text;-webkit-text-fill-color:transparent;}
.hdr-r{display:flex;align-items:center;gap:.45rem;}
.ubadge{display:flex;align-items:center;gap:.35rem;background:var(--sf2);border:1px solid var(--bd);border-radius:20px;padding:.25rem .6rem;font-size:.7rem;}
.uav{width:20px;height:20px;border-radius:50%;background:linear-gradient(135deg,var(--gr),var(--bl));display:flex;align-items:center;justify-content:center;font-size:.6rem;font-weight:800;color:#000;}
.ptag{padding:.12rem .42rem;border-radius:10px;font-size:.56rem;font-weight:700;font-family:'JetBrains Mono',monospace;text-transform:uppercase;}
.ptag-fr{background:var(--mu)22;color:var(--mu2);}
.ptag-pr{background:var(--go)22;color:var(--go);}
.ptag-pf{background:var(--or)22;color:var(--or);}
.ptag-ad{background:var(--pu)22;color:var(--pu);}
.logob{background:none;border:1px solid var(--bd);color:var(--mu2);border-radius:8px;padding:.25rem .62rem;font-size:.68rem;cursor:pointer;font-family:'Outfit',sans-serif;}
.scr{flex:1;overflow-y:auto;padding:1rem;padding-bottom:80px;}
.scr::-webkit-scrollbar{width:3px;}
.scr::-webkit-scrollbar-thumb{background:#ffffff15;border-radius:2px;}
.bnv{height:var(--nh);background:var(--sf);border-top:1px solid var(--bd);display:flex;flex-shrink:0;position:sticky;bottom:0;z-index:50;}
.nb{flex:1;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:.15rem;border:none;background:transparent;color:var(--mu);cursor:pointer;font-family:'Outfit',sans-serif;font-size:.58rem;font-weight:700;transition:color .2s;position:relative;}
.nb:active{opacity:.7;}.nb.on{color:var(--gr);}
.nb-ic{font-size:1.2rem;line-height:1;}
.nb-nt{position:absolute;top:6px;right:calc(50% - 13px);background:var(--rd);width:13px;height:13px;border-radius:50%;font-size:.48rem;font-weight:800;color:#fff;display:none;align-items:center;justify-content:center;}
.nb-nt.on{display:flex;}
.card{background:var(--sf2);border:1px solid var(--bd);border-radius:12px;padding:.85rem;margin-bottom:.6rem;}
.stit{font-size:.92rem;font-weight:800;margin-bottom:.7rem;display:flex;align-items:center;gap:.35rem;}
.sgrid{display:grid;grid-template-columns:1fr 1fr;gap:.55rem;margin-bottom:.9rem;}
.sc{background:var(--sf2);border:1px solid var(--bd);border-radius:11px;padding:.8rem;}
.sv{font-size:1.4rem;font-weight:900;line-height:1;}
.sl{font-size:.68rem;color:var(--mu2);margin-top:.1rem;}
.tru{font-size:.6rem;color:var(--gr);}
.pill{padding:.16rem .48rem;border-radius:20px;font-size:.6rem;font-weight:700;font-family:'JetBrains Mono',monospace;white-space:nowrap;}
.pill-pe{background:var(--yw)22;color:var(--yw);}
.pill-ac{background:var(--gr)22;color:var(--gr);}
.pill-ex{background:var(--rd)22;color:var(--rd);}
.pill-fr{background:var(--mu)22;color:var(--mu2);}
.pill-pr{background:var(--go)22;color:var(--go);}
.pill-po{background:var(--or)22;color:var(--or);}
.pill-et{background:var(--pu)22;color:var(--pu);}
.abtn{padding:.26rem .62rem;border:none;border-radius:7px;cursor:pointer;font-family:'Outfit',sans-serif;font-weight:700;font-size:.7rem;transition:opacity .2s;}
.abtn:active{opacity:.6;}
.abtn-g{background:var(--gr);color:#000;}
.abtn-r{background:var(--rd)22;color:var(--rd);border:1px solid var(--rd)33;}
.abtn-gh{background:#ffffff0d;color:var(--mu2);border:1px solid var(--bd);}
.abtn-o{background:var(--or);color:#000;}
.icob{background:none;border:none;cursor:pointer;font-size:.95rem;padding:.15rem;transition:opacity .2s;}
.icob:active{opacity:.5;}
.twrap{background:var(--sf2);border:1px solid var(--bd);border-radius:11px;overflow:auto;margin-bottom:.8rem;}
.dtbl{width:100%;border-collapse:collapse;font-size:.74rem;}
.dtbl th{background:var(--sf3);padding:.52rem .65rem;text-align:left;font-weight:700;color:var(--mu2);font-size:.63rem;text-transform:uppercase;letter-spacing:.5px;}
.dtbl td{padding:.52rem .65rem;border-bottom:1px solid var(--bd);}
.dtbl tr:last-child td{border-bottom:none;}

/* ÉLÈVE */
.abo-ban{border-radius:13px;padding:.85rem;margin-bottom:.9rem;display:flex;align-items:center;gap:.7rem;}
.abo-ban.fr{background:var(--sf2);border:1px solid var(--bd);}
.abo-ban.pr{background:linear-gradient(135deg,var(--go)15,var(--or)08);border:1px solid var(--go)33;}
.abo-ic{font-size:1.7rem;flex-shrink:0;}
.abo-tt{font-weight:800;font-size:.88rem;}
.abo-sb{font-size:.7rem;color:var(--mu2);margin-top:.08rem;}
.upgb{margin-left:auto;padding:.35rem .7rem;background:var(--go);color:#000;border:none;border-radius:7px;font-weight:800;font-size:.7rem;cursor:pointer;white-space:nowrap;flex-shrink:0;}
.ci{background:var(--sf2);border:1px solid var(--bd);border-radius:11px;padding:.8rem;margin-bottom:.5rem;display:flex;align-items:center;gap:.7rem;}
.cd{border-radius:7px;padding:.35rem .5rem;text-align:center;flex-shrink:0;}
.cd.gr{background:var(--gr)15;border:1px solid var(--gr)33;}
.cd.or{background:var(--or)15;border:1px solid var(--or)33;}
.cday{font-size:1rem;font-weight:900;line-height:1;}
.cday.gr{color:var(--gr);}.cday.or{color:var(--or);}
.cmon{font-size:.52rem;text-transform:uppercase;letter-spacing:.5px;}
.cmon.gr{color:var(--gr);}.cmon.or{color:var(--or);}
.cit{font-weight:700;font-size:.82rem;}
.cis{font-size:.68rem;color:var(--mu2);margin-top:.08rem;}
.jbtn{padding:.3rem .62rem;border:none;border-radius:7px;font-weight:700;font-size:.68rem;cursor:pointer;white-space:nowrap;}
.pri{background:var(--sf2);border:1px solid var(--bd);border-radius:11px;padding:.78rem;display:flex;align-items:center;gap:.65rem;cursor:pointer;transition:all .2s;margin-bottom:.45rem;}
.pri:active{transform:scale(.98);}
.pri.lk{opacity:.5;cursor:default;}
.pic{width:38px;height:38px;border-radius:9px;display:flex;align-items:center;justify-content:center;font-size:1.2rem;flex-shrink:0;}
.pn{font-weight:700;font-size:.83rem;}
.ps{font-size:.68rem;color:var(--mu2);margin-top:.07rem;}
.prog-bw{background:#ffffff12;border-radius:20px;height:7px;overflow:hidden;margin:.3rem 0;}
.prog-bf{height:100%;border-radius:20px;background:linear-gradient(90deg,var(--gr),var(--bl));transition:width .5s;}
.dvc{background:var(--sf2);border:1px solid var(--bd);border-radius:12px;padding:.85rem;margin-bottom:.55rem;}
.dvt{font-weight:800;font-size:.88rem;margin-bottom:.18rem;}
.dvm{font-size:.7rem;color:var(--mu2);margin-bottom:.45rem;}
.msgi{background:var(--sf2);border:1px solid var(--bd);border-radius:11px;padding:.7rem;margin-bottom:.45rem;}
.msgsn{font-size:.7rem;font-weight:700;color:var(--gr);margin-bottom:.12rem;}
.msgt{font-size:.82rem;color:var(--mu2);line-height:1.4;}
.msgti{font-size:.6rem;color:var(--mu);margin-top:.18rem;font-family:'JetBrains Mono',monospace;}

/* SALLE */
#s-cls{background:var(--bg);}
#btn-mic{display:none;align-items:center;gap:.28rem;padding:.25rem .6rem;border-radius:20px;border:1.5px solid var(--rd)44;font-family:'Outfit',sans-serif;font-weight:700;font-size:.68rem;cursor:pointer;background:var(--rd)15;color:var(--rd);flex-shrink:0;}
#btn-mic.show{display:flex;}
#btn-mic.on{background:var(--rd);color:#fff;border-color:var(--rd);box-shadow:0 0 14px var(--rd)55;animation:mpls 1s infinite;}
#btn-cam{display:none;align-items:center;gap:.28rem;padding:.25rem .6rem;border-radius:20px;border:1.5px solid var(--bl)44;font-family:'Outfit',sans-serif;font-weight:700;font-size:.68rem;cursor:pointer;background:var(--bl)15;color:var(--bl);flex-shrink:0;}
#btn-cam.show{display:flex;}
#btn-cam.on{background:var(--bl);color:#fff;border-color:var(--bl);box-shadow:0 0 12px var(--bl)55;}
@keyframes mpls{0%,100%{box-shadow:0 0 8px var(--rd)55;}50%{box-shadow:0 0 20px var(--rd)88;}}
@keyframes blk{0%,100%{opacity:1;}50%{opacity:.3;}}
.wbs{display:none;align-items:center;gap:2px;height:12px;}
.wbs.show{display:flex;}
.wb{width:3px;background:var(--rd);border-radius:2px;animation:wan .6s ease-in-out infinite;}
.wb:nth-child(1){height:4px;animation-delay:0s;}.wb:nth-child(2){height:9px;animation-delay:.1s;}.wb:nth-child(3){height:12px;animation-delay:.2s;}.wb:nth-child(4){height:7px;animation-delay:.3s;}.wb:nth-child(5){height:4px;animation-delay:.4s;}
@keyframes wan{0%,100%{transform:scaleY(.4);}50%{transform:scaleY(1);}}
#cls-tb{display:none;height:var(--th);background:#0a1422;border-bottom:1px solid var(--bd);align-items:center;padding:0 .6rem;gap:.38rem;overflow-x:auto;overflow-y:hidden;flex-shrink:0;scrollbar-width:none;}
#cls-tb::-webkit-scrollbar{display:none;}
#cls-tb.show{display:flex;}
.tb{padding:.32rem .72rem;border-radius:7px;border:none;font-family:'Outfit',sans-serif;font-weight:700;font-size:.73rem;cursor:pointer;white-space:nowrap;display:flex;align-items:center;gap:.22rem;flex-shrink:0;transition:opacity .2s;}
.tb:active{opacity:.7;}
.tb-g{background:var(--gr);color:#000;}.tb-gh{background:#ffffff0d;color:var(--mu2);border:1px solid var(--bd);}
.tb-go{background:var(--gr)1a;color:var(--gr);border:1px solid var(--gr)44;}
.tb-r{background:var(--rd)1a;color:var(--rd);border:1px solid var(--rd)33;}
.tb-b{background:var(--bl)1a;color:var(--bl);border:1px solid var(--bl)44;}
.sep{width:1px;height:20px;background:var(--bd);flex-shrink:0;}
.pp{background:#ffffff08;border:1px solid var(--bd);border-radius:7px;padding:.28rem .58rem;font-family:'JetBrains Mono',monospace;font-size:.68rem;color:var(--mu2);display:flex;align-items:center;gap:.25rem;flex-shrink:0;}
.pp b{color:var(--tx);}
.cdot{width:15px;height:15px;border-radius:50%;border:2px solid transparent;cursor:pointer;transition:transform .15s;flex-shrink:0;}
.cdot.sel{border-color:#fff;transform:scale(1.2);}
#cz{flex:1;overflow:auto;display:flex;align-items:flex-start;justify-content:center;background:#040810;position:relative;-webkit-overflow-scrolling:touch;}
#cz::-webkit-scrollbar{width:3px;}
#cz::-webkit-scrollbar-thumb{background:#ffffff15;border-radius:2px;}
#es{display:flex;flex-direction:column;align-items:center;justify-content:center;height:100%;width:100%;gap:.9rem;color:var(--mu);text-align:center;padding:2rem;}
.eic{font-size:3rem;opacity:.28;}.emg{font-size:.92rem;font-weight:600;opacity:.65;}.esb{font-size:.73rem;opacity:.38;font-family:'JetBrains Mono',monospace;}
#cw{display:none;position:relative;padding:.75rem;}
#pca{display:block;max-width:100%;border-radius:4px;box-shadow:0 6px 36px #00000099;}
#dca{position:absolute;top:.75rem;left:.75rem;pointer-events:none;border-radius:4px;}
#dca.active{pointer-events:all;cursor:crosshair;}
#sb{position:fixed;top:calc(var(--hh)+.4rem);right:.6rem;background:var(--gr)15;border:1px solid var(--gr)44;border-radius:7px;padding:.22rem .58rem;font-family:'JetBrains Mono',monospace;font-size:.6rem;color:var(--gr);display:none;align-items:center;gap:.28rem;z-index:5;}
#sb.show{display:flex;}
#sb::before{content:'';width:5px;height:5px;border-radius:50%;background:var(--gr);animation:blk 1s infinite;}
/* Caméra */
#cam-box{position:fixed;bottom:calc(var(--nh)+.5rem);left:.6rem;width:100px;height:75px;border-radius:10px;overflow:hidden;border:2px solid var(--bl)66;box-shadow:0 4px 20px #00000088;display:none;z-index:40;background:#000;}
#cam-box.show{display:block;}
#cam-box video{width:100%;height:100%;object-fit:cover;}
.cam-lbl{position:absolute;bottom:0;left:0;right:0;background:#000000aa;font-size:.52rem;text-align:center;padding:.15rem;color:var(--bl);font-family:'JetBrains Mono',monospace;}
/* Enregistrement */
#rec-ban{display:none;align-items:center;justify-content:space-between;padding:.4rem .9rem;background:var(--rd)15;border-bottom:1px solid var(--rd)22;flex-shrink:0;}
#rec-btn-zone{display:none;position:fixed;top:calc(var(--hh)+.4rem);left:.6rem;z-index:6;}
/* Audio banner */
#aud-ban{display:none;align-items:center;justify-content:center;gap:.5rem;background:var(--rd)15;border-bottom:1px solid var(--rd)33;padding:.42rem .9rem;flex-shrink:0;font-size:.76rem;color:var(--rd);font-weight:700;}
#aud-ban.show{display:flex;}
.abs{display:flex;align-items:center;gap:2px;height:11px;}
.ab{width:3px;background:var(--rd);border-radius:2px;animation:wan .5s ease-in-out infinite;}
.ab:nth-child(1){height:4px;}.ab:nth-child(2){height:9px;animation-delay:.12s;}.ab:nth-child(3){height:11px;animation-delay:.24s;}.ab:nth-child(4){height:6px;animation-delay:.36s;}.ab:nth-child(5){height:3px;animation-delay:.48s;}
/* Tableau blanc */
#wb-ov{position:fixed;inset:0;background:var(--bg);z-index:100;display:none;flex-direction:column;}
#wb-ov.show{display:flex;}
#wb-cv{flex:1;background:#fff;cursor:crosshair;touch-action:none;}
.wb-tb{height:52px;background:var(--sf);border-bottom:1px solid var(--bd);display:flex;align-items:center;padding:0 .7rem;gap:.4rem;overflow-x:auto;scrollbar-width:none;flex-shrink:0;}
.wb-tb::-webkit-scrollbar{display:none;}
/* Quiz */
#qz-ov{position:fixed;inset:0;background:#000000cc;z-index:100;display:none;align-items:center;justify-content:center;padding:1rem;}
#qz-ov.show{display:flex;}
.qz-card{background:var(--sf2);border:1px solid var(--bd);border-radius:20px;padding:1.5rem;width:100%;max-width:420px;max-height:88vh;overflow-y:auto;}
.qz-opt{background:var(--sf);border:1.5px solid var(--bd);border-radius:10px;padding:.72rem;margin-bottom:.45rem;cursor:pointer;transition:all .2s;font-size:.86rem;}
.qz-opt:active{opacity:.75;}
.qz-opt.sel{border-color:var(--gr);background:var(--gr)11;color:var(--gr);}
