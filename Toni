// DESSIN
function ajDraw(){const cv=el('pca');const dc=el('dca');dc.width=cv.width;dc.height=cv.height;drawCtx=dc.getContext('2d');}
function togAnnot(){annotOn=!annotOn;const dc=el('dca');dc.classList.toggle('active',annotOn);const bannEl=el('btn-ann');if(bannEl)bannEl.style.color=annotOn?'var(--gr)':'';elSet('col-row','display',annotOn?'flex':'none');}
function setCol(sc,scEl){drawColor=sc;document.querySelectorAll('.cdot').forEach(d=>d.classList.remove('sel'));if(scEl)scEl.classList.add('sel');}
function clearAnnot(){clearCv();if(fbOk){db.ref('classe/dessin').remove();db.ref('classe/effacer').set(Date.now());}}
function clearCv(){const dc=el('dca');if(drawCtx)drawCtx.clearRect(0,0,dc.width,dc.height);}
function dessT(t,bc){if(!drawCtx)return;drawCtx.beginPath();drawCtx.moveTo(t.x1,t.y1);drawCtx.lineTo(t.x2,t.y2);drawCtx.strokeStyle=t.c;drawCtx.lineWidth=t.sz||4;drawCtx.lineCap='round';drawCtx.lineJoin='round';drawCtx.stroke();if(bc&&fbOk&&CU.role==='prof'){batchT.push(t);clearTimeout(batchTmr);batchTmr=setTimeout(()=>{batchT.forEach(tr=>db.ref('classe/dessin').push(tr));batchT=[];},80);}}
function initDrawEvents(){
  const dca=el('dca');
  if(!dca)return;
  dca.addEventListener('mousedown',e=>{if(!annotOn)return;drawing=true;lx=e.offsetX;ly=e.offsetY;});
  dca.addEventListener('mousemove',e=>{if(!drawing||!annotOn)return;const sz=parseInt(document.getElementById('bsz').value||4);dessT({x1:lx,y1:ly,x2:e.offsetX,y2:e.offsetY,c:drawColor,sz},true);lx=e.offsetX;ly=e.offsetY;});
  dca.addEventListener('mouseup',()=>drawing=false);
  dca.addEventListener('mouseleave',()=>drawing=false);
  dca.addEventListener('touchstart',e=>{if(!annotOn)return;e.preventDefault();const r=e.target.getBoundingClientRect(),t=e.touches[0];lx=t.clientX-r.left;ly=t.clientY-r.top;drawing=true;},{passive:false});
  dca.addEventListener('touchmove',e=>{if(!drawing||!annotOn)return;e.preventDefault();const r=e.target.getBoundingClientRect(),t=e.touches[0];const x=t.clientX-r.left,y=t.clientY-r.top;const sz=parseInt(document.getElementById('bsz').value||4);dessT({x1:lx,y1:ly,x2:x,y2:y,c:drawColor,sz},true);lx=x;ly=y;},{passive:false});
  dca.addEventListener('touchend',()=>drawing=false);
}

// TERMINER
function terminerCours(){if(!confirm('Terminer le cours pour tous ?'))return;couperMic();stopCam();if(enregOn)stopRec();if(fbOk){db.ref('classe/etat').remove();db.ref('classe/dessin').remove();db.ref('classe/signaling').remove();db.ref('classe/quiz_actif').remove();}elSet('cw','display','none');elSet('es','display','flex');elSet('e-ic','text','✅');elSet('e-mg','text','Cours terminé');elSet('e-sb','text','');elSet('pp-pl','display','none');pdfDoc=null;clearCv();toast('✅ Cours terminé');}

// ÉLÈVES
function majEleves(data){try{const el=Object.values(data).filter(u=>u.role==='eleve');const nb=document.getElementById('nb-ec');if(nb)nb.textContent='('+el.length+')';const lst=el('elv-lst');if(!lst)return;if(!el.length){lst.innerHTML='<div style="text-align:center;color:var(--mu);font-size:.8rem;padding:2rem 0;opacity:.52">Aucun apprenant</div>';return;}lst.innerHTML=el.map(u=>'<div class="elvi"><div class="edo"></div><span>'+u.nom+'</span></div>').join('');}catch(e){}}

// CHAT
function envMsg(){const inp=el('ch-inp');if(!inp)return;const txt=inp.value.trim();if(!txt)return;inp.value='';const m={nom:CU.nom||'Utilisateur',role:CU.role,txt,ts:Date.now()};if(fbOk)db.ref('classe/chat').push(m);else affMsg(m);}
function affMsg(m){const z=el('ch-msgs');const d=document.createElement('div');d.className='cmsg';const isMe=m.nom===CU.nom&&m.role===CU.role;d.innerHTML='<div class="cmsg-w '+(m.role==="prof"?"p":"e")+'">'+m.nom+(isMe?' (moi)':'')+'</div><div class="cmsg-t">'+m.txt+'</div>';z.appendChild(d);const chbd=el('ch-bd');if(chbd)chbd.scrollTop=9999;}

// TABS CLASSE
function swCT(t){try{clsTab=t;const map={c:'nb-cr',cl:'nb-cl',ch:'nb-ch',q:'nb-qz'};Object.entries(map).forEach(([k,id])=>{const el=document.getElementById(id);if(el)el.classList.toggle('on',k===t);});closeCpn();if(t==='cl'){const p=document.getElementById('cp-cl');if(p)p.classList.add('show');}if(t==='ch'){const p=document.getElementById('cp-ch');if(p)p.classList.add('show');chatNL=0;const n=document.getElementById('ch-nt');if(n)n.classList.remove('on');setTimeout(()=>{const b=document.getElementById('ch-bd');if(b)b.scrollTop=9999;},80);}if(t==='q'){const p=document.getElementById('cp-qz');if(p)p.classList.add('show');}}catch(e){}}
function closeCpn(){try{['cp-cl','cp-ch','cp-qz'].forEach(id=>{const el=document.getElementById(id);if(el)el.classList.remove('show');});['nb-cr','nb-cl','nb-ch','nb-qz'].forEach((id,i)=>{const el=document.getElementById(id);if(el)el.classList.toggle('on',i===0);});}catch(e){}clsTab='c';}
document.addEventListener('click',e=>{['cp-cl','cp-ch','cp-qz'].forEach(id=>{try{const p=document.getElementById(id);const bnv=document.querySelector('.bnv');if(p&&p.classList.contains('show')&&!p.contains(e.target)&&bnv&&!bnv.contains(e.target))closeCpn();}catch(err){}});});

// ADMIN
function valider(btn,nm){
  const r=btn.closest('tr');
  // Trouver l'uid depuis data-uid si disponible
  const uid=r.dataset.uid;
  if(uid&&fbOk){
    db.ref('users/'+uid).update({statut:'actif'});
    db.ref('inscriptions/'+uid).update({statut:'actif'});
  }
  r.querySelector('.pill').className='pill pill-ac';
  r.querySelector('.pill').textContent='Actif';
  r.querySelectorAll('.icob').forEach(b=>b.remove());
  r.querySelector('td:last-child').innerHTML="<button class='icob' onclick=\"toast('Profil')\">👁️</button>";
  toast('✅ '+nm+' validé — accès activé');
}
function rejeter(btn,nm){const r=btn.closest('tr');r.style.opacity='.35';setTimeout(()=>r.remove(),400);toast('❌ '+nm+' rejeté');}

// UPGRADE
function showUpgrade(){elCls('mod-upg','add','show');}
function closeUpg(){elCls('mod-upg','remove','show');}
function selPlan(spEl,dur,price){planDur=dur;planPrice=price;document.querySelectorAll('.upp').forEach(p=>p.classList.remove('sel'));document.querySelectorAll('.upr').forEach(r=>r.classList.remove('sel'));if(spEl){spEl.classList.add('sel');const upr=spEl.querySelector('.upr');if(upr)upr.classList.add('sel');}}
function payer(){closeUpg();toast('💳 Envoyez '+planPrice+' FCFA au 54 36 81 80 · Code: TONI-PREM-'+planDur.replace(' ',''));}

// UTILS
function ldg(s){const ldgEl=el('ldg');if(ldgEl)ldgEl.classList.toggle('show',s);}
function toast(msg){const t=document.getElementById('tst');t.textContent=msg;t.classList.add('show');clearTimeout(t._t);t._t=setTimeout(()=>t.classList.remove('show'),2800);}
// Init au chargement
document.addEventListener('DOMContentLoaded', function(){
  const plPr = document.getElementById('pl-pr');
  if(plPr) plPr.style.display='none';
  const fbb = document.getElementById('fb-banner');
  if(fbb){
    // Cacher la bannière Firebase après 6s si pas configuré
    setTimeout(()=>{ if(fbb) fbb.style.display='none'; }, 8000);
  }
});
</script>
