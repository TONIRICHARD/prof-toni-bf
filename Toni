function ouvrirTB(){
  elCls('wb-ov','add','show');
  const cvs=document.getElementById('wb-cv');cvs.width=window.innerWidth;cvs.height=window.innerHeight-52;
  wbCtx=cvs.getContext('2d');wbCtx.fillStyle='#fff';wbCtx.fillRect(0,0,cvs.width,cvs.height);
  const getPos=(e)=>{const r=cvs.getBoundingClientRect();return{x:(e.touches?e.touches[0].clientX:e.clientX)-r.left,y:(e.touches?e.touches[0].clientY:e.clientY)-r.top};};
  let wd=false,wx=0,wy=0;
  const start=e=>{e.preventDefault();wd=true;const p=getPos(e);wx=p.x;wy=p.y;};
  const draw=e=>{if(!wd)return;e.preventDefault();const p=getPos(e);wbCtx.beginPath();wbCtx.moveTo(wx,wy);wbCtx.lineTo(p.x,p.y);wbCtx.strokeStyle=wbColor;wbCtx.lineWidth=parseInt(document.getElementById('wb-sz').value);wbCtx.lineCap='round';wbCtx.stroke();wx=p.x;wy=p.y;};
  const stop=()=>wd=false;
  cvs.onmousedown=start;cvs.onmousemove=draw;cvs.onmouseup=stop;cvs.onmouseleave=stop;
  cvs.ontouchstart=start;cvs.ontouchmove=draw;cvs.ontouchend=stop;
}
